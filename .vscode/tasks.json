{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "BMS: Start All",
      "dependsOn": ["BMS: Backend", "BMS: Frontend"],
      "dependsOrder": "parallel",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": []
    },
    {
      "label": "BMS: Install & Start All",
      "type": "shell",
      "command": "npm install --prefix backend && npm install --prefix frontend && npm run dev",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "new"
      },
      "problemMatcher": []
    },
    {
      "label": "BMS: Backend",
      "type": "shell",
      "command": "npm install && npm run dev",
      "options": {
        "cwd": "${workspaceFolder}/backend"
      },
      "presentation": {
        "reveal": "always",
        "panel": "new",
        "group": "bms"
      },
      "problemMatcher": []
    },
    {
      "label": "BMS: Frontend",
      "type": "shell",
      "command": "npm install && npm run dev",
      "options": {
        "cwd": "${workspaceFolder}/frontend"
      },
      "presentation": {
        "reveal": "always",
        "panel": "new",
        "group": "bms"
      },
      "problemMatcher": []
    }
  ]
}
